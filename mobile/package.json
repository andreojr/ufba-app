{
  "name": "gradline",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "android:dev": "APP_VARIANT=development expo run:android",
    "ios": "expo run:ios",
    "ios:dev": "APP_VARIANT=development expo run:ios",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@expo-google-fonts/poppins": "^0.4.1",
    "@expo-google-fonts/source-code-pro": "^0.4.1",
    "@expo/metro-runtime": "~57.0.12",
    "@expo/vector-icons": "^15.0.3",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@react-native-cookies/cookies": "^6.2.1",
    "@react-native-google-signin/google-signin": "^16.1.4",
    "cpf-cnpj-validator": "^2.1.2",
    "expo": "^57.0.15",
    "expo-calendar": "~57.0.2",
    "expo-constants": "~57.0.13",
    "expo-crypto": "~57.0.1",
    "expo-dev-client": "~57.0.14",
    "expo-file-system": "~57.0.5",
    "expo-font": "~57.0.1",
    "expo-intent-launcher": "~57.0.1",
    "expo-linking": "~57.0.7",
    "expo-modules-core": "~57.0.12",
    "expo-print": "~57.0.1",
    "expo-router": "~57.0.15",
    "expo-secure-store": "~57.0.1",
    "expo-sharing": "~57.0.14",
    "expo-splash-screen": "~57.0.7",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "expo-web-browser": "~57.0.2",
    "heroui-native": "^1.0.8",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.3.2",
    "uniwind": "^1.10.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.4",
    "eslint": "^9.39.4",
    "eslint-config-expo": "~57.0.1",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.4",
    "patch-package": "^8.0.1",
    "prettier": "^3.8.3",
    "typescript": "~5.9.3"
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg|cpf-cnpj-validator|standard-navigation)"

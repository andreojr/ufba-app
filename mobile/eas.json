{
  "cli": {
    "version": ">= 22.2.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "env": {
          "APP_VARIANT": "development"
        }
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://ufba-backend-production.up.railway.app",
        "EXPO_PUBLIC_GOOGLE_CLIENT_ID": "342733763492-a8meg4cvid7qmr97992uapouo89nv409.apps.googleusercontent.com"
      }
    },
    "production": {
      "autoIncrement": false,
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://ufba-backend-production.up.railway.app",
        "EXPO_PUBLIC_GOOGLE_CLIENT_ID": "342733763492-a8meg4cvid7qmr97992uapouo89nv409.apps.googleusercontent.com"
      }
    }
  }
}

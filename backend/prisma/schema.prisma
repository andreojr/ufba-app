generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Gradline's own identity (Google Sign-In only).
model User {
  id        String   @id @default(uuid())
  googleId  String   @unique @map("google_id")
  email     String   @unique
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  sigaaLink       SigaaLink?
  auditLogEntries AuditLog[]
  cachedGrades    CachedGrade[]
  cachedSchedules CachedSchedule[]

  @@map("users")
}

// Encrypted (AES-256-GCM) SIGAA credential, only written when the user opts
// into "lembrar senha". iv/authTag/ciphertext are base64. Never store the
// plaintext senha or the encryption key here.
model SigaaLink {
  userId                   String   @id @map("user_id")
  sigaaLogin               String   @map("sigaa_login")
  encryptedSenhaIv         String   @map("encrypted_senha_iv")
  encryptedSenhaAuthTag    String   @map("encrypted_senha_auth_tag")
  encryptedSenhaCiphertext String   @map("encrypted_senha_ciphertext")
  linkedAt                 DateTime @default(now()) @map("linked_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sigaa_link")
}

// Every time an encrypted SIGAA credential is decrypted (e.g. to relogin for a
// background notification fetch), an entry is written here — when and why.
model AuditLog {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  action    String
  reason    String
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("audit_log")
}

// Cached SIGAA data. Unused until the boletim.ts parser exists (blocked on a
// real HTML fixture, see docs/superpowers/spikes/2026-08-17-sigaa-investigation.md gotchas).
model CachedGrade {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  componente String
  data       Json
  fetchedAt  DateTime @default(now()) @map("fetched_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("cached_grades")
}

model CachedSchedule {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  semestre  String
  data      Json
  fetchedAt DateTime @default(now()) @map("fetched_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("cached_schedule")
}
